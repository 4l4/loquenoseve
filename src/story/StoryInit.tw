:: StoryInit
/* Variables guardadas para todo el juego (ver docs/plot.md) */
<<set $apariencia to 1>>
<<set $regla to "">>    /* "mayor" | "tres_veces" | "mano_derecha" */
<<set $fecha to "">>    /* "viernes" | "kimjang" | "enkutatash" */
<<set $cabala to "">>   /* "escupir" | "limon" | "unas" */
<<set $puntos to 0>>    /* puntos porteños */

/* Otras partes del proyecto (enlaces <a class="vn-ext" data-ext="…">): por ahora muestran el cartel «En desarrollo» */
<<set setup.ext to {
  mapa:     "El mapa",
  recetas:  "Las recetas",
  pelicula: "La película"
}>>
